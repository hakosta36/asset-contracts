{
  "name": "oracle-asset-contracts",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy-local.cjs --network localhost",
    "deploy": "hardhat run scripts/deploy.cjs --network bscTestnet",
    "export:abi": "node scripts/export-abi.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run compile && npm test && npm run format:check"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "ethers": "6.17.0",
    "hardhat": "2.28.6",
    "prettier": "3.6.2",
    "prettier-plugin-solidity": "2.1.0",
    "solc": "0.8.30",
    "solidity-coverage": "0.8.16"
  },
  "overrides": {
    "tmp": "0.2.7",
    "adm-zip": "0.6.1",
    "undici": "6.29.1",
    "serialize-javascript": "7.1.4",
    "uuid": "11.1.1",
    "bn.js@<5": "4.12.5",
    "bn.js@>=5": "5.2.5",
    "cookie": "0.7.2"
  }
}
